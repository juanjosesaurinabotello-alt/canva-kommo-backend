# Puerto del servidor HTTP
PORT=3000

# Origen permitido para CORS (la app UE5 empaquetada no lo necesita,
# pero el build Pixel Streaming / web si). Usar * solo en desarrollo.
CORS_ORIGIN=*

# Ruta del archivo donde se persisten los leads (opcional).
# Por defecto: src/data/leads.json
# LEADS_FILE=/ruta/absoluta/leads.json

# --- Solo para el despliegue serverless en Vercel (api/) ---
# Si se configuran, los leads se guardan en Vercel KV / Upstash Redis (REST).
# Si faltan, las functions usan /tmp (efimero). El servidor Express local
# NO usa estas variables (usa LEADS_FILE).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
