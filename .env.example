# Puerto del servidor HTTP
PORT=3000

# Origen permitido para CORS (la app UE5 empaquetada no lo necesita,
# pero el build Pixel Streaming / web sí). Usar * solo en desarrollo.
CORS_ORIGIN=*

# --- Kommo CRM ---
# Si KOMMO_BASE_URL o KOMMO_ACCESS_TOKEN faltan, el backend funciona en
# MODO MOCK: /units sirve el seed local y /leads no envia a Kommo (devuelve
# un id simulado). Esto permite demos 100% offline del MVP.
KOMMO_BASE_URL=https://tu-cuenta.kommo.com
KOMMO_ACCESS_TOKEN=
# Pipeline y etapa donde se crean los leads entrantes (opcional)
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=
